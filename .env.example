# Development environment

# Kafka / Zookeeper
ZOOKEEPER_CLIENT_PORT=2181
KAFKA_BROKER_ID=1
KAFKA_ZOOKEEPER_CONNECT=zookeeper:2181
KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT
KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://kafka:29092,PLAINTEXT_HOST://kafka:9092
KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0

# Postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=chatapps
POSTGRES_USER=chatapps
POSTGRES_PASSWORD=chatapps

# Cassandra
CASSANDRA_HOST=cassandra
CASSANDRA_PORT=9042

# Keycloak DB (MySQL)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=keycloak
MYSQL_USER=keycloak
MYSQL_PASSWORD=password

# Keycloak
KC_DB=mysql
KC_DB_URL_HOST=keycloak-mysql
KC_DB_URL_DATABASE=keycloak
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=password
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Spring datasource values will be composed in docker-compose.yml from POSTGRES_* variables

# Internal service URLs
USER_SERVICE_URL=http://user-service:9006
CHANNEL_SERVICE_URL=http://channel-service:9001
CHAT_SERVICE_URL=http://chat-service:9002

# Media service (name/service discovery)
MEDIA_SERVICE=media-service

