VITE_REACT_APP_BASE_URL="http://localhost:8888"

# Swagger / OpenAPI UI links for microservices
# Replace the host/port/path below with the actual URLs for your running services.
# Use VITE_ prefix so Vite exposes them to the client via import.meta.env
VITE_SWAGGER_API_GATEWAY="http://localhost:8888/swagger-ui/index.html"
VITE_SWAGGER_DISCOVERY_SERVER="http://localhost:8761" # Eureka UI (not Swagger)
VITE_SWAGGER_CHANNEL_SERVICE="http://localhost:9001/swagger-ui/index.html"
VITE_SWAGGER_CHAT_SERVICE="http://localhost:9002/swagger-ui/index.html"
VITE_SWAGGER_FRIENDSHIP_SERVICE="http://localhost:9003/swagger-ui/index.html"
VITE_SWAGGER_MEDIA_SERVICE="http://localhost:9004/swagger-ui/index.html"
VITE_SWAGGER_PRESENCE_SERVICE="http://localhost:9005/swagger-ui/index.html"
VITE_SWAGGER_USER_SERVICE="http://localhost:9006/swagger-ui/index.html"
