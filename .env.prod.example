# Production Environment Configuration Template
# Copy this file to .env.prod and update with your production values

# ========================================
# APPLICATION VERSION
# ========================================
APP_VERSION=latest

# ========================================
# DOCKER REGISTRY
# ========================================
DOCKERHUB_USERNAME=your-dockerhub-username
# Example: DOCKER_REGISTRY=sonnn128

# ========================================
# DATABASE CONFIGURATION
# ========================================
# PostgreSQL
POSTGRES_DB=chatapps_prod
POSTGRES_USER=chatapps_prod_user
POSTGRES_PASSWORD=your_strong_postgres_password_here

# MySQL (for Keycloak)
MYSQL_ROOT_PASSWORD=your_strong_mysql_root_password_here
MYSQL_DATABASE=keycloak_prod
MYSQL_USER=keycloak_prod_user
MYSQL_PASSWORD=your_strong_mysql_password_here

# ========================================
# KEYCLOAK CONFIGURATION
# ========================================
KEYCLOAK_DB=keycloak_prod
KEYCLOAK_HOSTNAME=your-domain.com
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=your_strong_keycloak_admin_password_here
KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=chat-apps
KEYCLOAK_RESOURCE=chat-apps-client
KEYCLOAK_CREDENTIALS_SECRET=your_keycloak_client_secret_here

# ========================================
# CLOUDINARY CONFIGURATION (Media Service)
# ========================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ========================================
# KAFKA CONFIGURATION
# ========================================
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ========================================
# EUREKA CONFIGURATION
# ========================================
EUREKA_SERVER_URL=http://localhost:8761/eureka

# ========================================
# API GATEWAY CONFIGURATION
# ========================================
API_GATEWAY_URL=http://api-gateway:8888/api/v1
NOTIFICATION_WS_URL=http://notification-service:8889/ws

# ========================================
# SPRING PROFILES
# ========================================
SPRING_PROFILES_ACTIVE=prod

# ========================================
# JAVA OPTIONS
# ========================================
JAVA_OPTS=-Xmx2048m -Xms512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# ========================================
# MONITORING (Optional)
# ========================================
# PROMETHEUS_ENABLED=true
# GRAFANA_ADMIN_PASSWORD=your_grafana_password

# ========================================
# LOGGING (Optional)
# ========================================
# LOG_LEVEL=INFO
# ELK_ENABLED=true
# ELASTICSEARCH_HOST=elasticsearch:9200

# ========================================
# SECURITY
# ========================================
# JWT_SECRET=your_jwt_secret_key_here_minimum_256_bits
# JWT_EXPIRATION=3600000

# ========================================
# BACKUP CONFIGURATION
# ========================================
# BACKUP_RETENTION_DAYS=7
# BACKUP_SCHEDULE=0 2 * * *

# ========================================
# NOTES
# ========================================
# 1. Never commit this file with actual passwords to version control
# 2. Use strong passwords for production (minimum 16 characters)
# 3. Keep this file secure and restrict access
# 4. Rotate passwords regularly
# 5. Use secrets management service in production (AWS Secrets Manager, HashiCorp Vault, etc.)
